/ {
    /* --- MACROS --- */
    macros {
        // Placeholder for F-key logic or other complex sequences
        macro_f_shifted: macro_f_shifted {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>; 
            label = "MACRO_F_SHIFTED";
        };
    };

    behaviors {
        /* --- 1. MOD-MORPHS (Context-Aware Keys) --- */
        mm_escape_grave: mm_escape_grave {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_ESCAPE_GRAVE";
            bindings = <&kp ESC>, <&kp GRAVE>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_backspace_del: mm_backspace_del {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_BACKSPACE_DEL";
            bindings = <&kp BACKSPACE>, <&kp DEL>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_round_bracket_left_exclaim: mm_round_bracket_left_exclaim {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_ROUND_BRACKET_LEFT_EXCLAIM";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp EXCLAMATION>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        mm_round_bracket_right_exclaim: mm_round_bracket_right_exclaim {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_ROUND_BRACKET_RIGHT_EXCLAIM";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp EXCLAMATION>;
            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        /* --- 2. TAP-DANCES (Multi-Tap Triggers) --- */
        td_hyper_meh: td_hyper_meh {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_HYPER_MEH";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(LG(LEFT_SHIFT)))>, <&kp LA(LC(LEFT_SHIFT))>;
            tapping-term-ms = <175>;
        };

        td_meh_hyper: td_meh_hyper {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MEH_HYPER";
            #binding-cells = <0>;
            bindings = <&kp LA(LC(LEFT_SHIFT))>, <&kp LA(LC(LG(LEFT_SHIFT)))>;
            tapping-term-ms = <175>;
        };

        td_caps_word_lock: td_caps_word_lock {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_CAPS_WORD_LOCK";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&caps_word>, <&kp CAPSLOCK>;
        };

        /* --- 3. HOLD-TAPS (Modifiers & Layer Shifts) --- */
        // Home Row Mods
        home_row_mod_left: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_LEFT";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <125>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 18 30 40 39 41 35 23 11 10 18 19 20 21 22 30 31 32 33 34 7 8 9>;
            hold-trigger-on-release;
        };

        home_row_mod_right: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HOME_ROW_MOD_RIGHT";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <125>;
            require-prior-idle-ms = <100>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
        };

        // Layer & Utility Hold-Taps
        custom_layer_tap: custom_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "CUSTOM_LAYER_TAP";
            bindings = <&mo>, <&kp>;
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <200>; // Increased for backspace spamming
        };

        custom_hold_tap: custom_hold_tap {
            compatible = "zmk,behavior-hold-tap";
            label = "CUSTOM_HOLD_TAP";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            quick-tap-ms = <125>;
            flavor = "tap-preferred";
        };

        custom_hold_tap_retro: custom_hold_tap_retro {
            compatible = "zmk,behavior-hold-tap";
            label = "CUSTOM_HOLD_TAP_RETRO";
            bindings = <&kp>, <&kp>;
            #binding-cells = <2>;
            tapping-term-ms = <150>;
            retro-tap;
            quick-tap-ms = <125>;
            flavor = "tap-preferred";
        };
    };
};
